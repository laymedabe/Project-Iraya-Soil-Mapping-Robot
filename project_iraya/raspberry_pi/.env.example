# Copy this file to .env and fill in real values. Never commit .env itself.

IRAYA_SECRET_KEY=change-this-to-a-random-string
IRAYA_DEBUG=false

# Set to "true" to develop the web app without a physical Arduino Mega attached
IRAYA_SERIAL_SIMULATE=true
IRAYA_SERIAL_PORT=/dev/ttyACM0
IRAYA_SERIAL_BAUD=9600

IRAYA_DB_HOST=localhost
IRAYA_DB_PORT=3306
IRAYA_DB_USER=iraya
IRAYA_DB_PASSWORD=changeme
IRAYA_DB_NAME=project_iraya

IRAYA_LAT_MIN=14.997
IRAYA_LAT_MAX=15.001
IRAYA_LON_MIN=120.998
IRAYA_LON_MAX=121.003

# Optional — only needed for scripts/sync_to_cloud.py
IRAYA_CLOUD_DB_HOST=
IRAYA_CLOUD_DB_USER=
IRAYA_CLOUD_DB_PASSWORD=
IRAYA_CLOUD_DB_NAME=project_iraya
